# ---------------------------------------------------------------------------
# Throughline environment
# Copy this file to `.env` and edit before starting the service.
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=4000
# Set to 1 when the service is behind a trusted reverse proxy (Caddy / Nginx).
TRUST_PROXY=0

# Storage — SQLite file; the directory is created automatically.
DATABASE_PATH=./data/throughline.db
BACKUP_DIR=./data/backups

# Security — REQUIRED in production. Generate with: openssl rand -hex 48
# Leave empty in development to use the built-in development secret.
SESSION_SECRET=
SESSION_TTL_DAYS=7

# Logging
LOG_LEVEL=info

# First-run administrator
# Required when the database is empty. Use a strong password in production.
# The account can sign in with either its email address or its display name.
BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# Allow public self-registration (teams are isolated from one another)
ALLOW_REGISTRATION=true

# Reverse proxy / TLS (used by the provided Caddy configuration)
APP_DOMAIN=localhost
